{
  "name": "safedesk",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "SafeDesk: multichain Safe owner rotations, Ledger signature collection, proposal tracking and guarded Tenderly simulations.",
  "scripts": {
    "test": "node --test scripts/safe-batch/*.test.mjs scripts/safedesk/*.test.mjs",
    "batch": "node scripts/safe-batch/cli.mjs",
    "safedesk": "node scripts/safe-batch/cli.mjs",
    "start": "node scripts/safedesk/start.mjs",
    "start:rotations": "node scripts/safe-batch/cli.mjs serve",
    "setup:manager": "npm exec --yes --package=bun@1.4.3 -- bun install --cwd apps/plainsafe --frozen-lockfile --ignore-scripts",
    "build:manager": "npm --prefix apps/plainsafe run build && node scripts/safedesk/build-integrity.mjs --record",
    "install:desk": "node scripts/safedesk/install.mjs",
    "verify:app": "node scripts/safedesk/build-integrity.mjs",
    "test:manager": "npm --prefix apps/plainsafe test -- --maxWorkers=4",
    "audit:manager": "npm exec --yes --package=bun@1.4.3 -- bun audit --cwd apps/plainsafe",
    "test:local": "node --test scripts/safedesk/*.test.mjs",
    "check:public": "node scripts/safedesk/check-public-source.mjs",
    "other-chains": "node scripts/other-chains/cli.mjs",
    "balances": "node scripts/audit-safe-balances.mjs",
    "discover": "node scripts/discover-safes.mjs",
    "generate": "node scripts/generate-rotation-json.mjs",
    "prepare-proposal": "node scripts/prepare-safe-service-proposal.mjs",
    "simulate-prepared": "python3 scripts/simulate-prepared-safe-vnet.py",
    "rotation": "node scripts/rotation-shortcut.mjs",
    "remaining": "node scripts/remaining-rotations.mjs"
  },
  "dependencies": {
    "@mysten/sui": "2.35.0",
    "ethers": "^6.13.4",
    "lucide": "^1.54.0",
    "safe-owner-manager": "^1.0.4"
  },
  "overrides": {
    "ws": "8.21.0"
  }
}
